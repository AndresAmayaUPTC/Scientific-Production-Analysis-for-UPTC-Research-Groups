# ---------------------------------------------------------------------------
# Copia este archivo como .env y rellena los valores. .env está en .gitignore:
# nunca subas credenciales al repositorio.
# ---------------------------------------------------------------------------

# --- Frontend ---
# URL del backend FastAPI. Sin ella, la app apunta a http://localhost:8000.
REACT_APP_API_URL=http://localhost:8000

# --- MongoDB Atlas ---
# Cadena de conexión del cluster. En Atlas: Database > Connect > Drivers.
# Formato: mongodb+srv://USUARIO:CONTRASENA@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=sci_uptc

# --- Scraping periódico ---
# Cada cuántas horas se relanza la ingesta del GrupLac. 720 = 30 días.
SCRAPE_INTERVAL_HOURS=720
# Qué hacer al arrancar el backend:
#   auto  lanza una ingesta si los datos están atrasados (recomendado)
#   true  lanza una siempre
#   false nunca; espera al primer disparo del intervalo
# Sin 'auto', un proceso que se reinicia antes de cumplirse el intervalo
# no llegaría a scrapear nunca.
SCRAPE_ON_STARTUP=auto
# Poner en false si la ingesta la dispara un cron externo o hay varias
# réplicas del backend (evita que todas scrapeen a la vez).
SCRAPE_SCHEDULER=true
SCRAPE_TIMEOUT=60
# Descargas simultáneas de fichas. Con 8 el portal cortaba conexiones.
SCRAPE_WORKERS=3
# Las fichas que fallan se reintentan de una en una, en varias rondas.
SCRAPE_RETRY_ROUNDS=3
SCRAPE_RETRY_PAUSE=3            # segundos entre fichas en un reintento
SCRAPE_RETRY_ROUND_PAUSE=30     # segundos antes de la 1.ª ronda (se duplica en cada una)

# --- Controles de calidad ---
# Una corrida no reemplaza a la vigente si no los cumple.
MIN_GRUPOS=100
MIN_PUBLICACIONES=5000
# Caída máxima tolerada frente a la versión vigente (0.20 = 20 %).
MAX_DROP_RATIO=0.20

# --- Respaldo ---
BACKUP_DIR=respaldos
BACKUP_KEEP=10
RUNS_KEEP=3
